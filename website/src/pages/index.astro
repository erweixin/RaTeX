---
import type { Locale } from "../i18n/types";
import { useTranslations, pageHref } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPlayground from "../components/HeroPlayground.astro";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const platformLinks = [
  { label: t.getStarted.platforms[0].title, hash: "web", meta: "npm · ratex-wasm" },
  { label: t.getStarted.platforms[1].title, hash: "ios", meta: "Swift Package · CoreGraphics" },
  { label: t.getStarted.platforms[2].title, hash: "android", meta: "Maven · JNI" },
  { label: t.getStarted.platforms[3].title, hash: "flutter", meta: "pub.dev · Dart FFI" },
  { label: t.getStarted.platforms[4].title, hash: "react-native", meta: "npm · native view" },
  { label: t.getStarted.platforms[5].title, hash: "server", meta: "Rust · PNG / SVG" },
] as const;

const pageTitle =
  lang === "zh"
    ? "RaTeX — 面向原生应用与 WebAssembly 的 Rust LaTeX 数学排版"
    : "RaTeX — Rust LaTeX math layout for native apps and WebAssembly";
const pageDescription =
  lang === "zh"
    ? "RaTeX 使用共享的 Rust 流水线解析并排版 LaTeX 数学，为 Web、Apple、Android、Flutter、React Native 与服务端输出显示列表。"
    : "RaTeX parses and lays out LaTeX math with a shared Rust pipeline for Web, Apple, Android, Flutter, React Native, and server renderers.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  active="home"
  lang={lang}
  copyright={t.footer.copyright}
>
  <link
    slot="head"
    rel="stylesheet"
    href={`${base}platforms/web/fonts.css`}
    data-ratex-fonts-stylesheet
  />

  <main class="pt-24 lg:pt-20">
    <header class="mx-auto max-w-7xl border-x border-b border-outline/30 px-5 py-10 sm:px-6 md:py-14 lg:py-16">
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(30rem,1.08fr)] lg:gap-12 xl:gap-16">
        <div class="max-w-2xl">
          <p class="mb-4 font-label text-xs uppercase tracking-[0.25em] text-primary">{t.home.eyebrow}</p>
          <h1 class="mb-6 text-4xl font-bold leading-[1.04] sm:text-5xl md:text-6xl lg:text-[4.25rem]">
            {t.home.heading}
          </h1>
          <p class="max-w-xl font-body text-lg leading-relaxed text-on-surface-variant sm:text-xl">
            {t.home.descMain}
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={pageHref("get-started.html", lang, base)}
              class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 font-label text-xs font-bold uppercase tracking-[0.16em] text-on-primary transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {t.nav.getStarted}
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={pageHref("demo/support-table.html", lang, base)}
              class="inline-flex items-center gap-2 rounded-lg border border-outline/60 bg-white px-5 py-3 font-label text-xs font-bold uppercase tracking-[0.16em] text-on-surface transition-colors hover:border-primary/50 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {t.home.alignmentLink}
            </a>
          </div>

          <dl class="mt-8 grid max-w-xl grid-cols-3 divide-x divide-outline/40 border-y border-outline/40 py-4">
            <div class="pr-3">
              <dt class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">Core</dt>
              <dd class="mt-1 text-sm font-semibold text-on-surface">Rust</dd>
            </div>
            <div class="px-3">
              <dt class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">Targets</dt>
              <dd class="mt-1 text-sm font-semibold text-on-surface">Native + WASM</dd>
            </div>
            <div class="pl-3">
              <dt class="font-mono text-[10px] uppercase tracking-wider text-on-surface-variant">License</dt>
              <dd class="mt-1 text-sm font-semibold text-on-surface">MIT</dd>
            </div>
          </dl>

          <p class="mt-6 max-w-xl text-sm leading-relaxed text-on-surface-variant">
            <strong class="text-on-surface">{t.home.alignmentLabel}</strong>
            {" "}{t.home.alignmentBody}
            {" "}<a
              href={pageHref("demo/support-table.html", lang, base)}
              class="font-medium text-primary underline underline-offset-2"
            >{t.home.alignmentLink}</a>
            {" "}{t.home.alignmentSuffix}
          </p>
        </div>

        <div class="w-full lg:sticky lg:top-24">
          <p class="mb-3 font-label text-xs uppercase tracking-[0.25em] text-primary/90">{t.home.tryIt}</p>
          <HeroPlayground
            msgLoading={t.heroPlayground.loading}
            msgEnterLatexAbove={t.heroPlayground.enterLatexAbove}
            msgRendering={t.heroPlayground.rendering}
            msgReady={t.heroPlayground.ready}
            msgCopied={t.heroPlayground.copied}
            msgUnavailable={t.heroPlayground.unavailable}
            labelPlayground={t.heroPlayground.playgroundLabel}
            labelInput={t.heroPlayground.inputLabel}
            labelOutput={t.heroPlayground.outputLabel}
            labelExamples={t.heroPlayground.examplesLabel}
            labelMathExample={t.heroPlayground.mathExample}
            labelChemistryExample={t.heroPlayground.chemistryExample}
            labelMatrixExample={t.heroPlayground.matrixExample}
            labelClear={t.heroPlayground.clear}
            labelCopy={t.heroPlayground.copy}
            labelRender={t.heroPlayground.render}
            labelCharacters={t.heroPlayground.characters}
            shortcutHint={t.heroPlayground.shortcutHint}
          />
        </div>
      </div>
    </header>

    <section
      id="platforms"
      class="mx-auto max-w-7xl border-x border-b border-outline/30 bg-surface-container-lowest/60 px-5 py-10 sm:px-6 md:py-12"
      aria-labelledby="platforms-heading"
    >
      <div class="mb-7 grid gap-3 md:grid-cols-[0.8fr_1.2fr] md:items-end md:gap-10">
        <div>
          <p class="mb-2 font-label text-xs uppercase tracking-[0.25em] text-primary/90">{t.home.packagesEyebrow}</p>
          <h2 id="platforms-heading" class="text-3xl font-bold md:text-4xl">{t.home.packagesHeading}</h2>
        </div>
        <p class="max-w-2xl text-sm leading-relaxed text-on-surface-variant md:justify-self-end md:text-base">
          {t.home.packagesDescPrefix}
          {" "}<a
            href={pageHref("get-started.html", lang, base)}
            class="font-medium text-primary underline underline-offset-2"
          >{t.home.packagesGetStarted}</a>{t.home.packagesDescSuffix}
        </p>
      </div>

      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          platformLinks.map((platform) => (
            <li>
              <a
                href={`${pageHref("get-started.html", lang, base)}#${platform.hash}`}
                class="group flex items-center justify-between gap-4 rounded-xl border border-outline/45 bg-white px-4 py-3.5 shadow-sm ring-1 ring-black/[0.02] transition-colors hover:border-primary/35 hover:bg-surface-container-lowest focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                <span>
                  <span class="block text-sm font-semibold text-on-surface group-hover:text-primary">{platform.label}</span>
                  <span class="mt-0.5 block font-mono text-[10px] text-on-surface-variant">{platform.meta}</span>
                </span>
                <span class="text-on-surface-variant transition-transform group-hover:translate-x-0.5 group-hover:text-primary" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      id="features"
      class="mx-auto max-w-7xl border-x border-b border-outline/30 px-5 py-12 sm:px-6 md:py-14"
      aria-labelledby="features-heading"
    >
      <h2 id="features-heading" class="mb-8 text-3xl font-bold md:text-4xl">{t.home.whenToUseHeading}</h2>
      <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-outline/40 bg-outline/40 md:grid-cols-3">
        <li class="bg-white p-6 md:p-7">
          <span class="font-mono text-xs text-primary">01</span>
          <h3 class="mt-5 text-2xl font-bold">{t.home.whenToUseNative}</h3>
          <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">{t.home.whenToUseNativeDesc}</p>
        </li>
        <li class="bg-white p-6 md:p-7">
          <span class="font-mono text-xs text-primary">02</span>
          <h3 class="mt-5 text-2xl font-bold">{t.home.whenToUseWasm}</h3>
          <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
            {t.home.whenToUseWasmDescPrefix}
            {" "}<a
              href={pageHref("demo/live.html", lang, base)}
              class="font-medium text-primary underline underline-offset-2"
            >{t.home.whenToUseWasmLink}</a>{t.home.whenToUseWasmDescSuffix}
          </p>
        </li>
        <li class="bg-white p-6 md:p-7">
          <span class="font-mono text-xs text-primary">03</span>
          <h3 class="mt-5 text-2xl font-bold">{t.home.whenToUseChem}</h3>
          <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
            <code class="rounded bg-surface-container px-1.5 py-0.5 text-xs">\ce</code>
            {" "}/ <code class="rounded bg-surface-container px-1.5 py-0.5 text-xs">\pu</code>
            {" "}/ <code class="rounded bg-surface-container px-1.5 py-0.5 text-xs">prooftree</code>
            {" "}{t.home.whenToUseChemDescSuffix}
          </p>
        </li>
      </ol>
    </section>

    <section
      id="compatibility"
      class="mx-auto max-w-7xl border-x border-b border-outline/30 bg-surface-container-lowest px-5 py-12 sm:px-6 md:py-14"
      aria-labelledby="compatibility-heading"
    >
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <p class="mb-3 font-label text-xs uppercase tracking-[0.25em] text-primary/90">{t.home.galleriesEyebrow}</p>
          <h2 id="compatibility-heading" class="text-3xl font-bold md:text-4xl">{t.home.comparisonHeading}</h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-on-surface-variant md:text-base">
            {t.home.comparisonDesc}
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <a
            href={pageHref("demo/live.html", lang, base)}
            class="rounded-xl border border-outline/45 bg-white p-5 transition-colors hover:border-primary/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span class="font-mono text-[10px] uppercase tracking-wider text-primary">WASM ↔ KaTeX</span>
            <h3 class="mt-2 text-xl font-bold">{t.demo.liveComparisonTitle}</h3>
            <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">{t.demo.liveComparisonBody}</p>
          </a>
          <a
            href={pageHref("demo/support-table.html", lang, base)}
            class="rounded-xl border border-outline/45 bg-white p-5 transition-colors hover:border-primary/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <span class="font-mono text-[10px] uppercase tracking-wider text-primary">Golden suite</span>
            <h3 class="mt-2 text-xl font-bold">{t.demo.supportTableTitle}</h3>
            <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">{t.demo.supportTableBody}</p>
          </a>
          <div class="rounded-xl border border-outline/45 bg-white p-5 sm:col-span-2">
            <span class="font-mono text-[10px] uppercase tracking-wider text-primary">{t.home.galleriesHeading}</span>
            <nav class="mt-3 flex flex-wrap gap-2" aria-label={t.home.galleriesHeading}>
              <a class="rounded-full bg-surface-container px-3 py-1.5 text-sm font-medium hover:text-primary" href={pageHref("math.html", lang, base)}>{t.nav.math}</a>
              <a class="rounded-full bg-surface-container px-3 py-1.5 text-sm font-medium hover:text-primary" href={pageHref("chemistry.html", lang, base)}>{t.nav.chemistry}</a>
              <a class="rounded-full bg-surface-container px-3 py-1.5 text-sm font-medium hover:text-primary" href={pageHref("physics.html", lang, base)}>{t.nav.physics}</a>
              <a class="rounded-full bg-surface-container px-3 py-1.5 text-sm font-medium hover:text-primary" href={pageHref("proof-trees.html", lang, base)}>{t.nav.proofs}</a>
            </nav>
          </div>
        </div>
      </div>
    </section>

    <section id="cta" class="mx-auto max-w-7xl border-x border-outline/30 px-5 py-12 sm:px-6 md:py-16">
      <div class="relative overflow-hidden rounded-2xl bg-primary px-6 py-10 text-center sm:px-10 md:py-14">
        <div class="pointer-events-none absolute -right-6 -top-8 opacity-10" aria-hidden="true">
          <span class="material-symbols-outlined text-[150px]" style="font-variation-settings: 'wght' 100">function</span>
        </div>
        <h2 class="relative z-10 mx-auto max-w-3xl text-3xl font-bold leading-tight text-on-primary md:text-4xl">
          {t.home.ctaHeading}
        </h2>
        <div class="relative z-10 mt-7 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href={pageHref("demo/live.html", lang, base)}
            class="rounded-lg bg-on-primary px-6 py-3 font-label text-xs font-bold uppercase tracking-[0.16em] text-primary transition-opacity hover:opacity-90"
          >{t.home.ctaLiveDemo}</a>
          <a
            href="https://github.com/erweixin/RaTeX#readme"
            class="rounded-lg border border-on-primary/70 px-6 py-3 font-label text-xs font-bold uppercase tracking-[0.16em] text-on-primary transition-colors hover:bg-white/10"
          >{t.home.ctaGithubReadme}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
